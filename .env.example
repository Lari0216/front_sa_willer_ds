# Copie para .env.local (não versionado) e ajuste conforme o ambiente.

# URL base do back-end (sem barra no final)
VITE_API_URL=http://localhost:3000

# true  = usa dados simulados (não precisa do back-end)
# false = consome a API real em VITE_API_URL
VITE_USE_MOCK=true

# Tempo máximo de espera por resposta da API, em milissegundos
VITE_REQUEST_TIMEOUT=15000
