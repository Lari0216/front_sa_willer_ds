# Usado no `npm run build`. Enquanto o back-end não estiver publicado na internet,
# o deploy funciona em modo demonstração (dados simulados).
# Quando a API estiver no ar: VITE_USE_MOCK=false e VITE_API_URL=https://sua-api.com
# (ou defina essas variáveis no painel da Vercel/Netlify, que têm prioridade).
VITE_API_URL=http://localhost:3000
VITE_USE_MOCK=true
